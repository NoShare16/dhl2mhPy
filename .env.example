# Umgebung (dev, prod)
APP_ENV=dev

# Plenty
PLENTY__USERNAME=
PLENTY__PASSWORD=

# Shopware
SHOPWARE__CLIENT_ID=
SHOPWARE__CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────
# Akeneo PIM API — zwei Instanzen: MK (mykitchens) und ML (mylivings)
# Username/Passwort sind gemeinsam (AKENEO__*), Client-Credentials je Instanz.
# ─────────────────────────────────────────────────────────────
AKENEOMK__BASE_URL=
AKENEOMK__CLIENT_ID=
AKENEOMK__SECRET=

AKENEOML__BASE_URL=
AKENEOML__CLIENT_ID=
AKENEOML__SECRET=

AKENEO__USERNAME=
AKENEO__PASSWORD=

# DHL DeliverIT (Basic Auth, password gets SHA1-hashed by the client)
DHL__UAT_USERNAME=
DHL__UAT_PASSWORD=
DHL__PROD_USERNAME=
DHL__PROD_PASSWORD=
DHL__LABEL_WAIT_SECONDS=180
# The acknowledgement queue is consume-once and large — its own long read
# timeout, and the raw answer is archived here before anything is parsed.
DHL__ACK_READ_TIMEOUT_SECONDS=600
DHL__ACK_ARCHIVE_DIR=var/dhl-acknowledgements

# SMTP for skipped-orders report
SMTP__HOST=smtp.mailbox.org
SMTP__PORT=587
SMTP__USERNAME=
SMTP__PASSWORD=
SMTP__FROM_EMAIL=
SMTP__FROM_NAME="DHL Label Service"

# Where the skipped-orders report goes
REPORT_RECIPIENT_EMAIL=

# Manueller Web-Trigger (optional — nur nötig, wenn dhl2mh.web betrieben wird).
# Leer lassen => Web-Trigger deaktiviert (reiner Cron-Betrieb).
WEB__USERNAME=
WEB__PASSWORD=
# Optionaler eigener Schlüssel zum Signieren des Login-Cookies.
# Leer => es wird aus WEB__PASSWORD abgeleitet (ein gesetztes Passwort reicht).
WEB__SECRET_KEY=